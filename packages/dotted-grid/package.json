{
  "name": "@tristimb/dotted-grid",
  "version": "0.1.2",
  "description": "A WebGL2 halftone custom element: renders a video as an animated dot grid, themed with CSS custom properties.",
  "license": "MIT",
  "author": "Tristan Timblin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tatimblin/dotgrid.git",
    "directory": "packages/dotted-grid"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target browser --format esm && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "bun test ./src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "bun run build"
  },
  "keywords": [
    "halftone",
    "webgl",
    "custom-element",
    "web-component",
    "video"
  ]
}
